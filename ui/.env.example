# API base URL (use http for local dev)
VITE_API_URL=https://stockguard-production-19c2.up.railway.app

# Google Sign-In: Web client ID from Google Cloud Console
# APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID (Web application)
# Use the same value as api's google.client-id
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Shopify App Configuration
VITE_SHOPIFY_API_KEY=your-shopify-api-key
VITE_SHOPIFY_HOST=https://stockguard-production-19c2.up.railway.app
